# ============== 矿池配置 ==============
# 矿池地址（host:port）
POOL_HOST="pool.pearlhash.xyz:9000"

# 可选矿池区域，仅用于展示/提示；实际连接以 POOL_HOST 为准
# - EU/US 默认: pool.pearlhash.xyz:9000
# - Asia     : 可在官网「Generate your launch command」选择 Asia 获取端点
POOL_REGION="EU/US"

# WildRig Multi 习惯在 URL 前加 stratum+tcp:// 前缀
# - true : 当 MINER_FLAVOR=wildrig 且 POOL_HOST 不以 stratum 开头时自动补全
# - false: 不自动补全（你需要在 POOL_HOST 里写完整前缀）
STRATUM_PREFIX_AUTO="true"

# 钱包地址（敏感信息）
USER_ADDRESS="prl1pldsjzegmcujgsp5rlhslp4gyg6zvkcqq2czmpqrptezay0pcmd8sveydvl"

# 工作者名称（矿池工作者标识）默认用 hostname，适合多机/多容器区分
WORKER_NAME="$(hostname)"

# 网络解析/连通失败时的提示文案（避免脚本内硬编码）
NETWORK_HINT="请确认 Clash 虚拟网卡/TUN 已开启，如刚打开建议等待几秒后重试。若仍失败可尝试切换 POOL_REGION 或直接 POOL_HOST 覆盖 Asia 端点。"


# ============== 矿工程序与版本（支持 pearl/wildrig 双策略）==============
# 选择使用哪种矿工：
# - pearl  : 官方 legacy pearlhash-miner（对 H100/H200 推荐）
# - wildrig: 官方更推荐 4090 的 WildRig Multi（建议默认）
MINER_FLAVOR="wildrig"

# 本地 miner 文件名（放在 bin/ 下）
# - 留空时根据 MINER_FLAVOR 自动推断：pearl-miner / wildrig
MINER_BIN_NAME=""

# WildRig Multi 启动时的算法名（pearlhash 固定，无需修改）
WILDRIG_ALGO="pearlhash"

# ⚠️ rank-128 软分叉（区块 > 96251）后 --pearlhash-kernel 参数已废弃，不再生效。
# WildRig 0.49.8+ 会自动选择最优 kernel，手动指定反而会导致大量 rejected。

# WildRig 专属：stdout 打印摘要的间隔（秒）
# - 0 : 使用 WildRig 默认值
WILDRIG_PRINT_TIME="30"

# WildRig 专属：原生 HTTP API 端口
# - >0 : 启用 API（status/metrics 会优先读 API）
# - 0  : 关闭 API（退化为解析日志）
WILDRIG_API_PORT="4058"

# WildRig 专属：是否开启内置 watchdog（与外层 bash 看门狗互补）
WILDRIG_WATCHDOG="true"

# 是否在 start 时自动检查更新（仅提示，不自动下载）
AUTO_VERSION_CHECK_ON_START="true"

# 自更新下载源：
# - github-pearlhash : pearlhash/pearlhash-miner releases
# - github-wildrig   : andru-kun/wildrig-multi releases
# - auto             : 根据 MINER_FLAVOR 自动选择（默认）
UPDATE_SOURCE="auto"


# ============== GPU 资源控制 ==============
# 指定使用哪些 GPU（逗号分隔）
# - 留空 : 使用全部 GPU
# - WildRig 对应 --gpu-list
GPU_DEVICES="0,1"

# 温度告警阈值（°C）
# - status 输出中超过此值会标红
# - MINER_FLAVOR=wildrig 时会映射到 --gpu-temp-limit
MAX_GPU_TEMP="95"
MAX_GPU_TEMP_RESUME="80"

# 是否严格独占 GPU：
# - true : 检测到其他 compute 进程就拒绝启动（更保守）
# - false: 仅打印警告（默认，适合与监控栈共存）
GPU_STRICT_EXCLUSIVE="false"

# 严格独占模式下忽略的进程名（逗号分隔，支持通配符）
# 典型忽略：监控 exporter、显示服务等轻量进程
GPU_IGNORE_PROCS="dcgm-exporter,nvidia-cuda-mps-control,Xorg"


# ============== 日志控制 ==============
# 当前日志超过此大小触发轮转（MB）
LOG_MAX_SIZE_MB="50"

# 归档保留份数（miner.log.1 ~ miner.log.N）
LOG_ROTATE_KEEP="7"

# 归档是否 gzip 压缩
LOG_COMPRESS="true"

# 是否同步写入结构化 stats.jsonl（即使有 API 也保留一份磁盘备份）
LOG_STATS_JSONL="true"

# 运行时轮转检查间隔（秒）
# - 0 : 关闭（仅在 start/status 时触发）
LOG_RUNTIME_CHECK_INTERVAL="3600"

# 运行时指标采样间隔（秒）：supervisor 在 miner 运行期间每隔此秒数采集一次
# 快照并落盘到 stats.jsonl（配合 LOG_STATS_JSONL=true 生效）。
# 该值修复了"矿工长期运行时 stats.jsonl 从不更新"的问题。
LOG_STATS_INTERVAL="60"


# ============== 进程守护 ==============
# 崩溃后是否自动重启
# - 若 WildRig 已开 --watchdog，也保留外层双保险
AUTO_RESTART="true"

# 最大连续重启次数（防启动循环）
AUTO_RESTART_MAX_RETRIES="5"

# 每次重启前等待（秒）
AUTO_RESTART_DELAY_SEC="5"

# 启动验证最长等待（秒）
STARTUP_VERIFY_TIMEOUT_SEC="30"

# 启动成功关键字（退化到日志验证时使用）
# WildRig: "new job from" 出现即表示矿池连接成功并开始接收任务（比等 speed 算力输出快得多）
# 若仍需要等算力确认，可改为 "speed"（但会多等 --print-time 秒）
STARTUP_VERIFY_KEYWORD_WILDRIG="new job from"
STARTUP_VERIFY_KEYWORD_PEARL="Hashrate Total"

# 启动失败关键字：任一出现即判定失败（会自动 stop）
# 说明：这是 bash 数组写法，本文件由脚本 eval 加载，因此可直接使用数组
# 注意：默认值保持保守，仅把"确定致命"的串作为失败判定，避免小写 error
# 或偶发 API 断开导致的临时匹配误杀正常启动。
STARTUP_FAIL_KEYWORDS=("FATAL" "Startup error" "failed to create CUDA context")


# ============== 矿池连通性检查 ==============
# 是否检查 DNS 解析（getent hosts）
POOL_DNS_CHECK="true"

# 是否做 TCP 端口预检查（优先 nc，其次 /dev/tcp+timeout）
POOL_TCP_CHECK="true"

# TCP 检查超时（秒）
POOL_TCP_TIMEOUT_SEC="5"


# ============== 磁盘与依赖预检 ==============
# logs/ 所在分区剩余空间低于此值打印警告（MB）
MIN_DISK_SPACE_MB="500"

